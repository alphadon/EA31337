From 3dc416c5e8a767f5f341eaff3a49a470b7bc0bdc Mon Sep 17 00:00:00 2001
From: Alphadon <chrisandkam@gmail.com>
Date: Fri, 31 Oct 2025 22:22:50 +0000
Subject: [PATCH 7/7] Fix: Avoid operator= method hiding with explicit field
 copying

Changes to resolve build 5370 operator= method hiding errors:

DateTime.struct.h:
- DateTimeEntry(const MqlDateTime&) constructor uses explicit field copy
- Avoids implicit operator= which causes method hiding

DateTime.mqh:
- DateTime(const DateTimeEntry&) constructor uses explicit field copy
- DateTime(const MqlDateTime&) constructor uses explicit field copy
- SetEntry() method uses explicit field copy
- All copy week_of_year field for DateTimeEntry

Fixes errors:
- 'call resolves to DateTimeEntry::operator= instead of MqlDateTime::operator='
- 'cannot convert parameter MqlDateTime& to const DateTimeEntry&'

Root cause: MQL5 build 5370 detects operator= method hiding when derived
class implicit operator= shadows base class operator= during const conversions
---
 DateTime.mqh      | 36 +++++++++++++++++++++++++++++++++---
 DateTime.struct.h | 10 +++++++++-
 2 files changed, 42 insertions(+), 4 deletions(-)

diff --git a/DateTime.mqh b/DateTime.mqh
index 872449ba..e2823936 100644
--- a/DateTime.mqh
+++ b/DateTime.mqh
@@ -61,8 +61,28 @@ class DateTime {
    * Class constructor.
    */
   DateTime() { TimeToStruct(TimeCurrent(), dt_curr); }
-  DateTime(const DateTimeEntry &_dt) { dt_curr.Set(_dt); }
-  DateTime(const MqlDateTime &_dt) { dt_curr.Set(_dt); }
+  DateTime(const DateTimeEntry &_dt) {
+    dt_curr.year = _dt.year;
+    dt_curr.mon = _dt.mon;
+    dt_curr.day = _dt.day;
+    dt_curr.hour = _dt.hour;
+    dt_curr.min = _dt.min;
+    dt_curr.sec = _dt.sec;
+    dt_curr.day_of_week = _dt.day_of_week;
+    dt_curr.day_of_year = _dt.day_of_year;
+    dt_curr.week_of_year = _dt.week_of_year;
+  }
+  DateTime(const MqlDateTime &_dt) {
+    dt_curr.year = _dt.year;
+    dt_curr.mon = _dt.mon;
+    dt_curr.day = _dt.day;
+    dt_curr.hour = _dt.hour;
+    dt_curr.min = _dt.min;
+    dt_curr.sec = _dt.sec;
+    dt_curr.day_of_week = _dt.day_of_week;
+    dt_curr.day_of_year = _dt.day_of_year;
+    dt_curr.week_of_year = 0;
+  }
   DateTime(datetime _dt) { dt_curr.Set(_dt); }

   /**
@@ -171,7 +191,17 @@ class DateTime {
   /**
    * Sets the new DateTimeEntry struct.
    */
-  void SetEntry(const DateTimeEntry &_dt) { dt_curr.Set(_dt); }
+  void SetEntry(const DateTimeEntry &_dt) {
+    dt_curr.year = _dt.year;
+    dt_curr.mon = _dt.mon;
+    dt_curr.day = _dt.day;
+    dt_curr.hour = _dt.hour;
+    dt_curr.min = _dt.min;
+    dt_curr.sec = _dt.sec;
+    dt_curr.day_of_week = _dt.day_of_week;
+    dt_curr.day_of_year = _dt.day_of_year;
+    dt_curr.week_of_year = _dt.week_of_year;
+  }

   /* Dynamic methods */

diff --git a/DateTime.struct.h b/DateTime.struct.h
index e8310de9..1116d384 100644
--- a/DateTime.struct.h
+++ b/DateTime.struct.h
@@ -233,7 +233,15 @@ struct DateTimeEntry : MqlDateTime {
   DateTimeEntry() { Set(); }
   DateTimeEntry(datetime _dt) { Set(_dt); }
   DateTimeEntry(const MqlDateTime& _dt) {
-    Set(_dt);
+    year = _dt.year;
+    mon = _dt.mon;
+    day = _dt.day;
+    hour = _dt.hour;
+    min = _dt.min;
+    sec = _dt.sec;
+    day_of_week = _dt.day_of_week;
+    day_of_year = _dt.day_of_year;
+    week_of_year = 0;
 #ifndef __MQL__
     throw NotImplementedException();
 #endif
--

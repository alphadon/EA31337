From 806e9c5f2700aac68cbd2e52eb7f844ad4e3cec2 Mon Sep 17 00:00:00 2001
From: Alphadon <chrisandkam@gmail.com>
Date: Fri, 31 Oct 2025 22:04:53 +0000
Subject: [PATCH 6/7] Fix: Replace struct assignment with explicit field
 copying for const MqlDateTime

DateTime.struct.h changes:
- Set(const MqlDateTime&) now copies fields explicitly instead of using assignment
- Avoids build 5370 error with implicit assignment operator on const reference
- Copies: year, mon, day, hour, min, sec, day_of_week, day_of_year

DateTime.mqh changes:
- All constructors and SetEntry now use Set() method instead of direct assignment
- Ensures proper handling of const reference parameters
- DateTime(const DateTimeEntry&), DateTime(const MqlDateTime&), SetEntry()

Fixes: 'cannot convert parameter MqlDateTime& to const DateTimeEntry&' at line 304
Root cause: MQL5 struct assignment doesn't properly handle const references
---
 DateTime.mqh      | 6 +++---
 DateTime.struct.h | 9 ++++++++-
 2 files changed, 11 insertions(+), 4 deletions(-)

diff --git a/DateTime.mqh b/DateTime.mqh
index e7ead35d..872449ba 100644
--- a/DateTime.mqh
+++ b/DateTime.mqh
@@ -61,8 +61,8 @@ class DateTime {
    * Class constructor.
    */
   DateTime() { TimeToStruct(TimeCurrent(), dt_curr); }
-  DateTime(const DateTimeEntry &_dt) { dt_curr = _dt; }
-  DateTime(const MqlDateTime &_dt) { dt_curr = _dt; }
+  DateTime(const DateTimeEntry &_dt) { dt_curr.Set(_dt); }
+  DateTime(const MqlDateTime &_dt) { dt_curr.Set(_dt); }
   DateTime(datetime _dt) { dt_curr.Set(_dt); }

   /**
@@ -171,7 +171,7 @@ class DateTime {
   /**
    * Sets the new DateTimeEntry struct.
    */
-  void SetEntry(const DateTimeEntry &_dt) { dt_curr = _dt; }
+  void SetEntry(const DateTimeEntry &_dt) { dt_curr.Set(_dt); }

   /* Dynamic methods */

diff --git a/DateTime.struct.h b/DateTime.struct.h
index 2f09a796..e8310de9 100644
--- a/DateTime.struct.h
+++ b/DateTime.struct.h
@@ -301,7 +301,14 @@ struct DateTimeEntry : MqlDateTime {
   }
   // Set date and time.
   void Set(const MqlDateTime& _time) {
-    THIS_REF = _time;
+    year = _time.year;
+    mon = _time.mon;
+    day = _time.day;
+    hour = _time.hour;
+    min = _time.min;
+    sec = _time.sec;
+    day_of_week = _time.day_of_week;
+    day_of_year = _time.day_of_year;
     // @fixit Should also set day of week.
   }
   void SetDayOfMonth(int _value) {
--

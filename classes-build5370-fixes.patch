From 4c7f9ddc306dc2731b9d612c663d03dfb72f7e49 Mon Sep 17 00:00:00 2001
From: Alphadon <chrisandkam@gmail.com>
Date: Fri, 31 Oct 2025 21:20:20 +0000
Subject: [PATCH 1/7] Update type references for MetaEditor 5.00 build 5370
 compatibility

- Fix SimpleRef operator= to return X* instead of void
- Update GetPointer to use size_t for better type safety
- Ensure all pointer operations use proper return types
---
 Refs.struct.h | 5 +++--
 Std.h         | 2 +-
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/Refs.struct.h b/Refs.struct.h
index 60ad5330..bdc244bd 100644
--- a/Refs.struct.h
+++ b/Refs.struct.h
@@ -63,14 +63,15 @@ struct SimpleRef {
   /**
    * Makes a reference to the given object.
    */
-  void operator=(X* _ptr) {
+  X* operator=(X* _ptr) {
     if (ptr_object == _ptr) {
       // Assigning the same object.
-      return;
+      return ptr_object;
     }
     Unset();

     ptr_object = _ptr;
+    return ptr_object;
   }

   /**
diff --git a/Std.h b/Std.h
index 1b7d70ab..d52b8e26 100644
--- a/Std.h
+++ b/Std.h
@@ -193,7 +193,7 @@ class color {

 // GetPointer(ptr).
 #ifndef __MQL__
-unsigned int GetPointer(void* _ptr) { return (unsigned int)_ptr; }
+size_t GetPointer(void* _ptr) { return (size_t)_ptr; }
 #endif

 // MQL defines.
--
2.51.1



From 949a885fe28c7fe68fc4c6012d5bc9fbff4d9cb7 Mon Sep 17 00:00:00 2001
From: Alphadon <chrisandkam@gmail.com>
Date: Fri, 31 Oct 2025 21:43:30 +0000
Subject: [PATCH 3/7] Fix: Change position variable from int to unsigned int in
 Dict.mqh and DictStruct.mqh

- Fixes build 5370 error: 'parameter convertion type int to uint & is not allowed'
- GetSlotByKey requires unsigned int& parameter, cannot accept int&
- Updated Dict.mqh line 122 operator[] method
- Updated DictStruct.mqh line 139 operator[] method
- Part of MetaEditor 5.00 build 5370 stricter type checking updates
---
 Dict.mqh       | 2 +-
 DictStruct.mqh | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/Dict.mqh b/Dict.mqh
index 26bd9705..33379ee7 100644
--- a/Dict.mqh
+++ b/Dict.mqh
@@ -119,7 +119,7 @@ class Dict : public DictBase<K, V> {
   V operator[](K key) {
     if (_mode == DictModeList) return GetSlot((unsigned int)key).value;

-    int position;
+    unsigned int position;
     DictSlot<K, V>* slot = GetSlotByKey(_DictSlots_ref, key, position);

     if (!slot) return (V)NULL;
diff --git a/DictStruct.mqh b/DictStruct.mqh
index b4cb0d74..28c11cae 100644
--- a/DictStruct.mqh
+++ b/DictStruct.mqh
@@ -136,7 +136,7 @@ class DictStruct : public DictBase<K, V> {
   V operator[](K key) {
     DictSlot<K, V>* slot;

-    int position;
+    unsigned int position;

     if (_mode == DictModeList)
       slot = GetSlot((unsigned int)key);
--
